# Copy to .env (git-ignored) and fill in. run-local.ps1 loads it and starts the agent with these settings.
# Leave AZURE_OPENAI_ENDPOINT empty to run the agent in mock mode (keyword ranking, not AI).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key from the resource's Keys and Endpoint page>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Behind a TLS-inspecting proxy, point Python at a PEM bundle that includes the proxy's root certificate.
# SSL_CERT_FILE=C:\certs\windows-roots.pem
